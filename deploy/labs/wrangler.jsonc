// Labs: static Worker. Serves ../../labs at labs.dre.me.uk only.
// Deploy from the repo root:  npx wrangler@4 deploy -c deploy/labs/wrangler.jsonc
{
  "name": "dre-labs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../labs" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "labs.dre.me.uk", "custom_domain": true }]
}
