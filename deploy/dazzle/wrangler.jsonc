// DazzleDre: static Worker. Serves ../../labs at dazzle.dredarkroom.com and dazzle.dre.me.uk.
// Deploy from the repo root:  npx wrangler@4 deploy -c deploy/dazzle/wrangler.jsonc
// Needs the dredarkroom.com and dre.me.uk zones to be in the Cloudflare account you deploy with.
{
  "name": "dazzledre",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": "../../labs" },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "dazzle.dredarkroom.com", "custom_domain": true },
    { "pattern": "dazzle.dre.me.uk", "custom_domain": true }
  ]
}
