# Copy to .env (never commit it). Everything has a safe dev default except where noted.
PORT=3000
NODE_ENV=development
# Public base URL, used in payment redirect URLs (required in production)
BASE_URL=http://localhost:3000
DATABASE_PATH=./data/shop.db
# REQUIRED in production. In dev, a random one is generated and printed at boot.
ADMIN_PASSWORD=
# mock | stripe
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Seed demo products into an empty DB. Defaults to true in dev, false in production.
SEED_DEMO=
